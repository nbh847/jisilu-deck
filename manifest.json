{
  "manifest_version": 3,
  "name": "jisilu-deck",
  "version": "0.2.0",
  "description": "在集思录可转债列表维护本地自选，并支持仅显示当前站内结果中的本地自选。",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.jisilu.cn/web/data/cb/*",
        "https://www.jisilu.cn/data/*"
      ],
      "js": [
        "src/content/watchlist-store.js",
        "src/content/page-adapter.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
